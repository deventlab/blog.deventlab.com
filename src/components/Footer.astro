---
import Default from '@astrojs/starlight/components/Footer.astro';

// Giscus only on actual blog post pages — not the blog index, pagination,
// tag, or author pages. Mirrors starlight-blog's own isAnyBlogPostPage()
// check (not part of its public exports, so replicated here against its
// default 'blog' prefix rather than imported).
const { id } = Astro.locals.starlightRoute;
const isBlogPost = /^blog\/(?!(\d+\/?|tags\/.+|authors\/.+)$).+$/.test(id ?? '');
---

<Default />

{
  isBlogPost && (
    <script
      src="https://giscus.app/client.js"
      data-repo="deventlab/deventlab.com"
      data-repo-id="R_kgDOSg6oSw"
      data-category="Announcements"
      data-category-id="DIC_kwDOSg6oS84DCPdn"
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    />
  )
}
