---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---

<Base
  title="deventlab blog: distributed systems, simply"
  description="Engineering notes from deventlab on distributed systems, Raft consensus and the open-source projects built on d-engine."
>
  <main class="wrap">
    <section class="hero">
      <h1>Notes on building distributed systems, simply.</h1>
      <p class="sub">Raft consensus, embedded coordination, and the engineering behind d-engine and the projects built on it.</p>
    </section>
    <PostList posts={posts} featured />
  </main>
</Base>

<style>
  .hero { padding: 80px 0 48px; }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); line-height: 1.1; margin: 0 0 20px; color: var(--dl-primary); letter-spacing: -0.02em; max-width: 820px; }
  .sub { color: var(--dl-muted); font-size: 1.2rem; max-width: 640px; margin: 0; }
</style>
