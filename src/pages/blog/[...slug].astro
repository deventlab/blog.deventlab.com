---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostMeta from "../../components/PostMeta.astro";
import Giscus from "../../components/Giscus.astro";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · deventlab blog`} description={post.data.excerpt}>
  <main class="wrap">
    <article class="post">
      <p class="back"><a href="/">← All posts</a></p>
      <h1>{post.data.title}</h1>
      <PostMeta post={post} />
      <div class="prose"><Content /></div>
    </article>
    <div class="comments"><Giscus /></div>
  </main>
</Base>

<style>
  .post { max-width: 760px; margin: 0 auto; padding-top: 56px; }
  .back { margin: 0 0 24px; font-size: 0.9rem; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.15; margin: 0 0 16px; color: var(--dl-primary); letter-spacing: -0.02em; }
  .comments { max-width: 760px; margin: 56px auto 0; }

  .prose { margin-top: 32px; font-size: 1.05rem; }
  .prose :global(h2) { font-size: 1.6rem; margin: 2.4em 0 0.6em; color: var(--dl-primary); letter-spacing: -0.01em; }
  .prose :global(h3) { font-size: 1.2rem; margin: 2em 0 0.5em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1em; }
  .prose :global(li) { margin-bottom: 0.35em; }
  .prose :global(a) { text-underline-offset: 3px; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--dl-border); }
  .prose :global(blockquote) { margin: 1.4em 0; padding: 4px 20px; border-left: 3px solid var(--dl-primary); color: var(--dl-muted); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--dl-border); margin: 2.4em 0; }
  .prose :global(:not(pre) > code) { background: #eceff3; padding: 2px 6px; border-radius: 6px; font-size: 0.9em; }
  .prose :global(pre) { background-color: var(--dl-primary) !important; padding: 20px; border-radius: 12px; overflow-x: auto; font-size: 0.88rem; line-height: 1.55; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.4em 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--dl-border); }
  .prose :global(th) { color: var(--dl-muted); font-size: 0.85rem; }
</style>
